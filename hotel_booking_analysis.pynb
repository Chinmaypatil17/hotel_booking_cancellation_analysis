   ]
  },
  {
   "cell_type": "code",
   "execution_count": 159,
   "id": "9b93ca4a-c3a7-445a-80ec-40e9711df4ce",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "      reserved_room_type assigned_room_type  requested_room\n",
      "25683                  F                  F               0\n",
      "14626                  A                  I               1\n",
      "69100                  F                  F               0\n",
      "46062                  A                  D               1\n",
      "84242                  A                  A               0\n",
      "92613                  A                  A               0\n",
      "2230                   E                  E               0\n",
      "58523                  A                  A               0\n",
      "6119                   A                  A               0\n",
      "75730                  A                  A               0\n"
     ]
    }
   ],
   "source": [
    "# Define the room type hierarchy (A=best, L=worst)\n",
    "room_rank = {\n",
    "    'A': 1,  # Best\n",
    "    'B': 2,\n",
    "    'C': 3,\n",
    "    'D': 4,\n",
    "    'E': 5,\n",
    "    'F': 6,\n",
    "    'G': 7,\n",
    "    'H': 8,\n",
    "    'I': 9,\n",
    "    'J': 10,\n",
    "    'K': 11,\n",
    "    'L': 12  # Worst\n",
    "}\n",
    "\n",
    "# Create the requested_room column\n",
    "df['requested_room'] = np.where(\n",
    "    df['assigned_room_type'].map(room_rank) <= df['reserved_room_type'].map(room_rank),\n",
    "    0,  # assigned room is equal or worse (reserved_room_type >= assigned_room_type)\n",
    "    1   # assigned room is better (reserved_room_type < assigned_room_type)\n",
    ")\n",
    "\n",
    "# Verify the results\n",
    "print(df[['reserved_room_type', 'assigned_room_type', 'requested_room']].sample(10))"
   ]
  },
