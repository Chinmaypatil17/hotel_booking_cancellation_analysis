   "source": [
    "# Overall cancellation rate\n",
    "cancel_rate = df['is_canceled'].mean()\n",
    "\n",
    "# Cancellation count\n",
    "cancel_count = df['is_canceled'].sum()\n",
    "\n",
    "# Completed bookings count\n",
    "completed_count = len(df) - cancel_count\n",
    "\n",
    "print(f\"Cancellation Rate: {cancel_rate:.1%}\")\n",
    "print(f\"Total Cancellations: {cancel_count:,}\")"
   ]
  },
