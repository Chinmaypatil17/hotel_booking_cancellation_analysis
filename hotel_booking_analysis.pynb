     "text": [
      "\n",
      "High-risk Guests Cancellation Rate: 91.8%\n",
      "These guests represent 5.4% of all bookings\n"
     ]
    }
   ],
   "source": [
    "# Cancellation rate by number of previous cancellations\n",
    "prev_cancel_impact = df.groupby('previous_cancellations')['is_canceled'].mean()\n",
    "\n",
    "# Focus on guests with prior cancellations\n",
    "high_risk_guests = df[df['previous_cancellations'] > 0]\n",
    "print(f\"\\nHigh-risk Guests Cancellation Rate: {high_risk_guests['is_canceled'].mean():.1%}\")\n",
    "print(f\"These guests represent {len(high_risk_guests)/len(df):.1%} of all bookings\")"
   ]
