   "source": [
    "# Bin lead time into meaningful groups\n",
    "bins = [0, 7, 30, 90, 365, float('inf')]\n",
    "labels = ['0-7', '8-30', '31-90', '91-365', '365+']\n",
    "df['lead_time_group'] = pd.cut(df['lead_time'], bins=bins, labels=labels)\n",
    "\n",
    "# Cancellation rate by lead time group\n",
    "lead_time_impact = df.groupby('lead_time_group')['is_canceled'].mean()\n",
    "print(\"\\nCancellation Rate by Lead Time:\")\n",
    "print(lead_time_impact.sort_values(ascending=False))"
   ]
  },
