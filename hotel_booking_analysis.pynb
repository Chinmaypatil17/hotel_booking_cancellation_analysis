   ],
   "source": [
    "# Find the most problematic segment\n",
    "worst_segment = segment_analysis.index[0]\n",
    "worst_rate = segment_analysis.iloc[0]['mean']\n",
    "\n",
    "# Find most significant lead time threshold\n",
    "significant_lead_threshold = lead_time_impact[lead_time_impact > cancel_rate].index[0]\n",
    "\n",
    "print(f\"\\nKey Insights:\")\n",
    "print(f\"- {worst_segment} bookings cancel {worst_rate:.1%} of the time (vs avg {cancel_rate:.1%})\")\n",
    "print(f\"- Cancellations spike after {significant_lead_threshold} days lead time\")\n"
   ]
