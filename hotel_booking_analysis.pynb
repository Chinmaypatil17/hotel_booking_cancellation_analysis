   "source": [
    "segment_analysis = df.groupby('market_segment')['is_canceled'].agg(['mean', 'count'])\n",
    "segment_analysis = segment_analysis.sort_values('mean', ascending=False)\n",
    "print(\"\\nCancellation by Market Segment:\")\n",
    "print(segment_analysis)"
   ]
